                android:id="@+id/widget_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#F2EFE8"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_location_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#8A8478"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_color_right_1"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitXY"
            android:background="#C8922A"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_title_right_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#F2EFE8"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="#8A8478" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_event_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
