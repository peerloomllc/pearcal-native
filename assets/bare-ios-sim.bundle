  decode(state) {
    const r0 = c.string.decode(state)
    const r1 = c.uint.decode(state)
    const r2 = c.uint.decode(state)
    const flags = c.uint.decode(state)

    return {
      plugin: r0,
      version: r1,
      command: r2,
      value: (flags & 1) !== 0 ? c.buffer.decode(state) : null
    }
  }
