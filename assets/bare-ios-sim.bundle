}

function getEncoding(name) {
  switch (name) {
    case '@corestore/allocated':
      return encoding0
    case '@corestore/head':
      return encoding1
    case '@corestore/alias':
      return encoding2
    case '@corestore/core':
      return encoding3
    case '@core/hashes':
      return encoding4
    case '@core/signatures':
      return encoding5
    case '@core/tree-node':
      return encoding6
    case '@core/signer':
      return encoding7
    case '@core/prologue':
      return encoding8
    case '@core/manifest':
      return encoding9
    case '@core/keyPair':
      return encoding10
    case '@core/auth':
      return encoding11
    case '@core/head':
      return encoding12
    case '@core/hints':
      return encoding13
    case '@core/session':
      return encoding14
    case '@core/sessions':
      return encoding15
    case '@core/dependency':
