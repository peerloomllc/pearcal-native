  "devDependencies": {
    "bare-process": "^4.2.2",
    "brittle": "^3.1.0",
    "hypercore": "^11.0.0",
    "lunte": "^1.0.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "protocol-buffers": "^4.2.0",
    "sub-encoder": "^1.0.6",
