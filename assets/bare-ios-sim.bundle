  constructor() {
    this.count = 0
    this.pending = []
  }

  add(core) {
    if (this.count === 0) return
    this.pending.push(core.findingPeers())
  }

  inc(sessions) {
    if (++this.count !== 1) return

    for (const core of sessions) {
      this.pending.push(core.findingPeers())
    }
  }

  dec(sessions) {
    if (--this.count !== 0) return
    while (this.pending.length > 0) this.pending.pop()()
  }
}

