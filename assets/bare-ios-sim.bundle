    switch (version) {
      case 0:
      case 1: {
        const decoded = encoding16.decode(state, version)
        const map = external0.infoLegacyMap
        return map(decoded)
      }
      case 2: {
        const decoded = encoding17.decode(state, version)
        return decoded
