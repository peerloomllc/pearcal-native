  get id() {
    return this.core === null ? null : this.core.id
  }

  get key() {
    return this.core === null ? null : this.core.key
  }

  get discoveryKey() {
    return this.core === null ? null : this.core.discoveryKey
  }

  get manifest() {
    return this.core === null ? null : this.core.manifest
  }

  get length() {
