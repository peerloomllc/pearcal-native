    throw new Error('mac')
  if (n?.byteLength !== binding.crypto_secretbox_NONCEBYTES)
    throw new Error('n')
  if (k?.byteLength !== binding.crypto_secretbox_KEYBYTES) throw new Error('k')

  const res = binding.crypto_secretbox_detached(c, mac, m, n, k)

