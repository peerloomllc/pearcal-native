+            headWriter._pearcalWantedTo = rawHead.length
+            try {
+              const req = headCore.download({ start: headCore.contiguousLength, end: rawHead.length })
+              if (req && req.done) req.done().catch(() => {})
+            } catch (e) { /* best effort */ }
+          }
+        }
+        await new Promise(resolve => setImmediate(resolve))
+
         return false
       }
 
