diff --git a/node_modules/autobase/lib/writer.js b/node_modules/autobase/lib/writer.js
index 551406d..c66b2fb 100644
--- a/node_modules/autobase/lib/writer.js
+++ b/node_modules/autobase/lib/writer.js
@@ -281,6 +281,32 @@ module.exports = class Writer extends ReadyResource {
 
       if (headWriter !== this && (headWriter === null || headWriter.length < rawHead.length)) {
         if (!boot) this.base._ensureWakeup(headWriter)
+
+        // PearCal patch (#154). A device that HOLDS this writer's core but not
+        // its BLOCKS used to re-queue here forever. Two problems, both on this
+        // failure path only:
+        //   1. Nothing ever asked for the missing blocks. _ensureWakeup nudges
+        //      the writer but does not request a range never downloaded (or
+        //      since discarded), so the wait cannot resolve.
+        //   2. The retry starved the process. Measured on a real install
+        //      2026-08-05: ~45,000 declines in 90s, ZERO peer connections
+        //      completed, and a 90s setTimeout never fired - so the device
+        //      could not reach a blind seeder holding exactly those blocks.
+        // Request the range once per writer per target length, then yield so
+        // replication, the DHT and timers get a turn. Yielding is free here:
+        // this path is about to return false and be retried anyway.
+        const headCore = headWriter && headWriter.core
+        if (headCore && headCore.length >= rawHead.length && headCore.contiguousLength < rawHead.length) {
+          if (headWriter._pearcalWantedTo !== rawHead.length) {
+            headWriter._pearcalWantedTo = rawHead.length
+            try {
+              const req = headCore.download({ start: headCore.contiguousLength, end: rawHead.length })
+              if (req && req.done) req.done().catch(() => {})
+            } catch (e) { /* best effort */ }
+          }
+        }
+        await new Promise(resolve => setImmediate(resolve))
+
         return false
       }
 
